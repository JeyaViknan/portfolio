---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import sansUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import { profile } from '../data/content';
import { ui } from '../lib/icons';

interface Props {
  title: string;
  description: string;
  accent?: string;
}

const { title, description, accent } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site ? new URL('/og.png', site).href : '/og.png';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en-IN" style={accent ? `--accent: ${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jeya Viknan's network map of projects, drawn as coloured transit lines" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion');
          // If the motion script never runs, show everything anyway.
          setTimeout(function () { if (!window.__motionReady) d.classList.remove('motion'); }, 2500);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header" data-header>
      <div class="wrap header-inner">
        <a class="brand" href="/">{profile.name}</a>
        <nav class="nav" aria-label="Primary">
          <a href={path === '/' ? '#work' : '/#work'}>Work</a>
          <a href={path === '/' ? '#route' : '/#route'}>About</a>
          <a class="keep" href={path === '/' ? '#contact' : '/#contact'}>Contact</a>
          <a class="btn resume" href={profile.resume}>
            <span class="icon" set:html={ui.fileText} />
            Résumé
          </a>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>© {new Date().getFullYear()} {profile.name} · {profile.location}</p>
        <p class="credits">Set in Geist. Logos from Simple Icons, interface icons from Lucide.</p>
      </div>
    </footer>

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(255 255 255 / 0.86);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms var(--ease);
  }

  .site-header:global(.scrolled) {
    border-bottom-color: var(--rule);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
    font-size: 0.92rem;
  }

  .nav a:not(.btn) {
    color: var(--ink-2);
    text-decoration: none;
  }

  .nav a:not(.btn):hover {
    color: var(--ink);
  }

  .resume {
    min-height: 2.25rem;
    padding: 0.5rem 0.85rem;
  }

  @media (max-width: 34rem) {
    .nav a:not(.btn):not(.keep) {
      display: none;
    }

    .brand {
      font-size: 0.98rem;
    }
  }

  .site-footer {
    margin-top: var(--s9);
    border-top: 1px solid var(--rule);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s3) var(--s6);
    padding-block: var(--s6) var(--s7);
    font-size: var(--t-small);
    color: var(--ink-3);
  }
</style>
