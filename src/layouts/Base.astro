---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import sansUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import { profile } from '../data/content';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  accent?: string;
}

const { title, description, accent } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site ? new URL('/og.png', site).href : '/og.png';
---
<!doctype html>
<html lang="en-IN" style={accent ? `--accent: ${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A split-flap departure board reading Jeya Viknan, software engineer, with projects listed as departures" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <Header />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>© {new Date().getFullYear()} {profile.name} · {profile.location}</p>
        <p class="credits">Set in Geist. Logos from Simple Icons, interface icons from Lucide.</p>
      </div>
    </footer>

    <script>
      import '../scripts/scroll';
    </script>
  </body>
</html>

<style>
  .site-footer {
    margin-top: var(--s9);
    border-top: 1px solid var(--rule);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s3) var(--s6);
    padding-block: var(--s6) var(--s7);
    font-size: var(--t-small);
    color: var(--ink-3);
  }
</style>
