---
import Base from '../layouts/Base.astro';
import NetworkMap from '../components/NetworkMap.astro';
import DepartureBoard from '../components/DepartureBoard.astro';
import Cover from '../components/Cover.astro';
import TechChip from '../components/TechChip.astro';
import { profile, claims } from '../data/content';
import { lines, stations, work, route, recognition, toolkit } from '../data/network';
import { tech, brands, ui } from '../lib/icons';

const projects = claims.map((c) => ({ ...c, meta: work[c.slug], lineData: lines[work[c.slug].line] }));
const featured = projects.filter((p) => p.meta.featured);
const more = projects.filter((p) => !p.meta.featured);
const interchanges = stations.filter((s) => s.lines.length > 1).length;

// Which projects use each tool, for the toolkit dots.
const usedBy = (id: string) => projects.filter((p) => p.meta.tech.includes(id));
const routeColor = (l: string) => (l === 'study' ? 'var(--ink)' : lines[l as keyof typeof lines].color);
---
<Base title={`${profile.name} · Software engineer`} description={profile.description}>
  <DepartureBoard />

  <section id="network" class="map-section wrap" aria-labelledby="map-title">
    <div class="map-head">
      <h2 id="map-title" class="label">The network, 2023 to now</h2>
      <p class="label">{Object.keys(lines).length} lines · {stations.length - 1} stations · {interchanges} interchanges</p>
    </div>
    <NetworkMap />
  </section>

  <section id="work" class="work wrap" aria-labelledby="work-title">
    <div class="section-head">
      <p class="label">Selected work</p>
      <h2 id="work-title">Four stops worth the detour</h2>
      <p class="section-lede">Each one makes a promise, then shows how it is kept and where it stops holding. Every case study has a model you can run in the browser.</p>
    </div>

    <div class="features">
      {featured.map((p, i) => (
        <article class:list={['feature', { flip: i % 2 === 1 }]} style={`--line: ${p.lineData.color}; --tint: ${p.lineData.tint}`}>
          <a class="feature-media" href={`/${p.slug}/`} tabindex="-1" aria-hidden="true">
            {p.meta.image ? (
              <img src={p.meta.cover ?? p.meta.image.src} alt="" width="1200" height="900" loading="lazy" decoding="async" />
            ) : (
              <Cover id={p.slug} />
            )}
          </a>
          <div class="feature-body">
            <p class="feature-top">
              <span class="bullet" data-line={p.meta.line}>{p.n}</span>
              <span class="label">{p.lineData.name} line</span>
            </p>
            <h3><a href={`/${p.slug}/`}>{p.heldBy}</a></h3>
            <p class="kind">{p.kind}</p>
            <p class="promise" style={`view-transition-name: claim-${p.slug}`}>{p.statement}</p>
            <dl class="metrics">
              {p.meta.metrics.map((m) => (
                <div>
                  <dt>{m.label}</dt>
                  <dd>{m.value}</dd>
                </div>
              ))}
            </dl>
            <ul class="chips" aria-label="Built with">
              {p.meta.tech.map((t) => <li><TechChip id={t} /></li>)}
            </ul>
            <div class="feature-actions">
              <a class="btn primary" href={`/${p.slug}/`}>Read the case study <span class="icon" set:html={ui.arrowRight} /></a>
              {p.links[0] && (
                <a class="btn" href={p.links[0].href} rel="noopener">
                  <svg class="gh" viewBox="0 0 24 24" aria-hidden="true"><path d={brands.github.path} fill="currentColor" /></svg>
                  Code
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="more-head">
      <h2 class="h3">More on the map</h2>
    </div>
    <ul class="more">
      {more.map((p) => (
        <li style={`--line: ${p.lineData.color}; --tint: ${p.lineData.tint}`}>
          <a class="mini" href={`/${p.slug}/`}>
            <span class="mini-media" aria-hidden="true">
              {p.meta.image ? (
                <img src={p.meta.image.src} alt="" width={p.meta.image.width} height={p.meta.image.height} loading="lazy" decoding="async" />
              ) : (
                <Cover id={p.slug} />
              )}
            </span>
            <span class="mini-body">
              <span class="mini-top">
                <span class="bullet" data-line={p.meta.line}>{p.n}</span>
                <span>
                  <span class="mini-name">{p.heldBy}</span>
                  <span class="mini-kind">{p.kind}</span>
                </span>
              </span>
              <span class="mini-promise">{p.statement}</span>
              <span class="mini-metric"><b>{p.meta.metrics[0].value}</b> {p.meta.metrics[0].label}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="route" class="about wrap" aria-labelledby="about-title">
    <div class="about-text">
      <p class="label">About</p>
      <h2 id="about-title">The person behind the map</h2>
      <p>I’m most at home on problems where something has to stay true under pressure: money that must balance, capacity that has to be shared fairly, attendance that can’t be faked, answers that have to show their sources.</p>
      <p>I co-founded HUDO, a software services company, where I turn each client’s problem into scoped features before anything is built. At VITeach I lead a team of more than ten developers. Before that came research at NIT Tiruchirappalli, and most recently production RAG at Integra Global Solutions.</p>

      <h3 class="sub">Recognition</h3>
      <ul class="recognition">
        {recognition.map((r) => {
          const brand = brands[r.icon as keyof typeof brands];
          const inner = (
            <>
              <span class="rec-icon" aria-hidden="true">
                {brand ? (
                  <svg viewBox="0 0 24 24"><path d={brand.path} fill={`#${brand.hex}`} /></svg>
                ) : (
                  <span class="icon" set:html={ui.award} />
                )}
              </span>
              <span>
                <span class="rec-title">{r.title}</span>
                <span class="rec-note">{r.note}</span>
              </span>
            </>
          );
          return <li>{r.href ? <a href={r.href} rel="noopener">{inner}</a> : <div>{inner}</div>}</li>;
        })}
      </ul>
    </div>

    <div class="route">
      <p class="label">The route so far</p>
      <ol>
        {route.map((r) => (
          <li id={r.id} style={`--c: ${routeColor(r.line)}`}>
            <span class="stop" aria-hidden="true"></span>
            <span class="when mono">{r.when}</span>
            <div>
              <p class="r-title">{r.href ? <a href={r.href}>{r.title}</a> : r.title}</p>
              <p class="r-org">{r.org}</p>
              {r.note && <p class="r-note">{r.note}</p>}
            </div>
          </li>
        ))}
        <li class="future" style="--c: var(--ink-3)">
          <span class="stop" aria-hidden="true"></span>
          <span class="when mono">May 2027</span>
          <div>
            <p class="r-title">Graduation</p>
            <p class="r-org">Then the next stop</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section id="toolkit" class="toolkit wrap" aria-labelledby="toolkit-title">
    <div class="section-head">
      <p class="label">Toolkit</p>
      <h2 id="toolkit-title">What I build with</h2>
      <p class="section-lede">Coloured dots mark the projects on this page where each tool does real work.</p>
    </div>
    <div class="tool-groups">
      {toolkit.map((g) => (
        <div class="tool-group">
          <h3 class="label">{g.group}</h3>
          <ul>
            {g.items.map((id) => {
              const t = tech[id];
              const users = usedBy(id);
              return (
                <li class="tool">
                  <span class="tool-logo" aria-hidden="true">
                    {t.icon ? <svg viewBox="0 0 24 24"><path d={t.icon.path} fill={`#${t.icon.hex}`} /></svg> : <span class="tool-mono">{t.label.slice(0, 2)}</span>}
                  </span>
                  <span class="tool-name">{t.label}</span>
                  {users.length > 0 && (
                    <span class="tool-users">
                      {users.map((u) => (
                        <a href={`/${u.slug}/`} style={`--c: ${u.lineData.color}`} title={u.heldBy} aria-label={`Used in ${u.heldBy}`}></a>
                      ))}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <svg class="contact-line" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 20 H1200" stroke="var(--ink)" stroke-width="6" stroke-dasharray="2 18" stroke-linecap="round" fill="none" />
    </svg>
    <div class="wrap contact-inner">
      <p class="label">Contact</p>
      <h2 id="contact-title">Next stop: your team.</h2>
      <p class="contact-lede">I’m graduating in May 2027. If you’re building something that has to hold up, I’d like to hear about it.</p>
      <div class="contact-actions">
        <a class="btn primary big" href={`mailto:${profile.email}`}><span class="icon" set:html={ui.mail} /> {profile.email}</a>
        <button type="button" class="btn big js-only" data-copy={profile.email}><span class="icon" set:html={ui.copy} /> <span data-copy-label>Copy</span></button>
      </div>
      <ul class="contact-links">
        <li><a href={profile.github} rel="me"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={brands.github.path} fill="currentColor" /></svg> github.com/JeyaViknan</a></li>
        <li><a href={profile.linkedin} rel="me"><span class="icon" set:html={ui.arrowUpRight} /> linkedin.com/in/jeya-viknan</a></li>
        <li><a href={profile.resume}><span class="icon" set:html={ui.fileText} /> Résumé (PDF)</a></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (label) label.textContent = 'Copied';
      } catch {
        if (label) label.textContent = 'Press ⌘C';
      }
      setTimeout(() => label && (label.textContent = 'Copy'), 2000);
    });
  });
</script>

<style>
  /* Map */
  .map-section {
    padding-top: var(--s7);
    padding-bottom: var(--s8);
  }

  .map-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s2) var(--s5);
    margin-bottom: var(--s3);
  }

  .map-head h2 {
    letter-spacing: 0.04em;
    font-weight: 450;
  }

  /* Section heads */
  .section-head {
    max-width: 44rem;
    margin-bottom: var(--s7);
  }

  .section-head h2 {
    margin-top: var(--s3);
    font-size: var(--t-h2);
  }

  .section-lede {
    margin-top: var(--s4);
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .work {
    padding-top: var(--s8);
    border-top: 1px solid var(--rule);
  }

  /* Featured */
  .features {
    display: grid;
    gap: var(--s8);
  }

  .feature {
    display: grid;
    gap: var(--s5) clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .feature {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    }

    .feature.flip .feature-media {
      order: 2;
    }
  }

  .feature-media {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: calc(var(--radius) + 8px);
    overflow: hidden;
    background: var(--tint);
    box-shadow: inset 0 0 0 1px rgb(14 14 16 / 0.05);
  }

  .feature-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 600ms var(--ease);
  }

  .feature-media :global(svg) {
    transition: transform 600ms var(--ease);
  }

  .feature:hover .feature-media img,
  .feature:hover .feature-media :global(svg) {
    transform: scale(1.025);
  }

  .feature-top {
    display: flex;
    align-items: center;
    gap: var(--s3);
  }

  .feature h3 {
    margin-top: var(--s4);
    font-size: var(--t-h2);
  }

  .feature h3 a {
    text-decoration: none;
  }

  .kind {
    margin-top: var(--s2);
    color: var(--ink-3);
  }

  .promise {
    margin-top: var(--s4);
    font-size: var(--t-lead);
    font-weight: 520;
    line-height: 1.35;
    letter-spacing: -0.01em;
    padding-left: var(--s4);
    border-left: 4px solid var(--line);
    text-wrap: balance;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: var(--s4);
    margin-top: var(--s5);
  }

  .metrics div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.2rem;
  }

  .metrics dd {
    font-size: clamp(1.7rem, 1.3rem + 1.2vw, 2.3rem);
    font-weight: 680;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--line);
    font-variant-numeric: tabular-nums;
  }

  .metrics dt {
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--ink-2);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--s5);
  }

  .feature-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: var(--s5);
  }

  .gh {
    width: 1rem;
    height: 1rem;
  }

  /* More */
  .more-head {
    margin-top: var(--s9);
    margin-bottom: var(--s5);
  }

  .h3 {
    font-size: var(--t-h3);
  }

  .more {
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17.5rem), 1fr));
  }

  .mini {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--rule);
    border-radius: calc(var(--radius) + 4px);
    overflow: hidden;
    text-decoration: none;
    background: var(--paper);
    transition: border-color 180ms var(--ease), box-shadow 180ms var(--ease), transform 180ms var(--ease);
  }

  .mini:hover {
    border-color: var(--line);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .mini-media {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--tint);
    overflow: hidden;
  }

  .mini-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .mini-body {
    display: grid;
    gap: var(--s3);
    padding: var(--s4) var(--s4) var(--s5);
  }

  .mini-top {
    display: flex;
    align-items: center;
    gap: var(--s3);
  }

  .mini-top .bullet {
    font-size: 0.75rem;
  }

  .mini-name {
    display: block;
    font-weight: 640;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .mini-kind {
    display: block;
    font-size: 0.82rem;
    color: var(--ink-3);
  }

  .mini-promise {
    font-size: 0.98rem;
    line-height: 1.4;
  }

  .mini-metric {
    font-size: 0.82rem;
    color: var(--ink-2);
  }

  .mini-metric b {
    font-size: 1.05rem;
    font-weight: 680;
    color: var(--line);
    margin-right: 0.2rem;
  }

  /* About */
  .about {
    display: grid;
    gap: var(--s7) clamp(2rem, 6vw, 6rem);
    margin-top: var(--s9);
    padding-top: var(--s8);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 60rem) {
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .about-text h2 {
    margin-top: var(--s3);
    margin-bottom: var(--s5);
    font-size: var(--t-h2);
  }

  .about-text > p:not(.label) {
    color: var(--ink-2);
    font-size: 1.08rem;
    text-wrap: pretty;
  }

  .about-text > p + p {
    margin-top: var(--s4);
  }

  .sub {
    margin-top: var(--s7);
    margin-bottom: var(--s4);
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .recognition {
    display: grid;
    gap: var(--s2);
  }

  .recognition a,
  .recognition div {
    display: flex;
    align-items: center;
    gap: var(--s4);
    padding: var(--s3) var(--s4);
    border: 1px solid var(--rule);
    border-radius: 12px;
    text-decoration: none;
  }

  .recognition a:hover {
    border-color: var(--ink);
  }

  .rec-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    background: var(--paper-2);
    flex: none;
  }

  .rec-icon svg,
  .rec-icon .icon {
    width: 1.2rem;
    height: 1.2rem;
  }

  .rec-icon .icon {
    color: var(--amber);
  }

  .rec-title {
    display: block;
    font-weight: 600;
    line-height: 1.3;
  }

  .rec-note {
    display: block;
    font-size: 0.85rem;
    color: var(--ink-3);
  }

  .route > .label {
    margin-bottom: var(--s5);
  }

  .route li {
    position: relative;
    display: grid;
    grid-template-columns: 1.5rem 5.5rem minmax(0, 1fr);
    gap: var(--s3);
    padding-bottom: var(--s5);
  }

  .route li::before {
    content: '';
    position: absolute;
    left: calc(0.75rem - 3px);
    top: 0.9rem;
    bottom: -0.4rem;
    width: 6px;
    background: var(--c);
    border-radius: 3px;
  }

  .route li.future::before {
    display: none;
  }

  .route li:nth-last-child(2)::before {
    background: repeating-linear-gradient(var(--c) 0 6px, transparent 6px 12px);
  }

  .stop {
    position: relative;
    z-index: 1;
    width: 1.1rem;
    height: 1.1rem;
    margin: 0.2rem auto 0;
    border-radius: 50%;
    background: #fff;
    border: 4px solid var(--c);
  }

  .future .stop {
    border-style: dashed;
    border-width: 2.5px;
  }

  .when {
    padding-top: 0.25rem;
    color: var(--ink-3);
  }

  .r-title {
    font-weight: 620;
    line-height: 1.3;
  }

  .r-title a {
    text-decoration-color: var(--rule-strong);
  }

  .r-org {
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  .r-note {
    margin-top: var(--s2);
    font-size: 0.9rem;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .route li:target .r-title {
    color: var(--blue);
  }

  /* Toolkit */
  .toolkit {
    margin-top: var(--s9);
    padding-top: var(--s8);
    border-top: 1px solid var(--rule);
  }

  .tool-groups {
    display: grid;
    gap: var(--s6);
  }

  .tool-group {
    display: grid;
    gap: var(--s3);
  }

  @media (min-width: 56rem) {
    .tool-group {
      grid-template-columns: 13rem minmax(0, 1fr);
      align-items: start;
    }

    .tool-group h3 {
      padding-top: 0.9rem;
    }
  }

  .tool-group ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    gap: var(--s2);
  }

  .tool {
    display: flex;
    align-items: center;
    gap: var(--s3);
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--paper);
  }

  .tool-logo {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
  }

  .tool-logo svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .tool-mono {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ink-2);
  }

  .tool-name {
    flex: 1;
    min-width: 0;
    font-size: 0.92rem;
    font-weight: 520;
    line-height: 1.25;
  }

  /* Project dots overlap like a stack, so any number of them stays inside the tile. */
  .tool-users {
    display: flex;
    flex: none;
    padding-left: 0.2rem;
  }

  .tool-users a {
    width: 0.7rem;
    height: 0.7rem;
    margin-left: -0.2rem;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 2px var(--paper);
    transition: transform 160ms var(--ease);
  }

  .tool-users a:hover,
  .tool-users a:focus-visible {
    position: relative;
    z-index: 1;
    transform: scale(1.3);
  }

  /* Contact */
  .contact {
    position: relative;
    margin-top: var(--s9);
    background: var(--amber);
    color: var(--ink);
    overflow: hidden;
  }

  .contact-line {
    width: 100%;
    height: 40px;
  }

  .contact-inner {
    padding-top: var(--s6);
    padding-bottom: var(--s9);
  }

  .contact .label {
    color: rgb(14 14 16 / 0.7);
  }

  .contact h2 {
    margin-top: var(--s3);
    font-size: clamp(2.4rem, 1.4rem + 4.6vw, 5.4rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
    max-width: 12ch;
  }

  .contact-lede {
    margin-top: var(--s5);
    max-width: 34rem;
    font-size: var(--t-lead);
    line-height: 1.5;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: var(--s6);
  }

  .btn.big {
    min-height: 3.1rem;
    padding: 0.8rem 1.25rem;
    font-size: 1rem;
